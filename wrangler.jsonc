{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monthly-expense-ai",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-13",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
