{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monthly-expense",
  "main": "./public",
  "compatibility_date": "2026-08-13",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sync-room",
      "new_sqlite_classes": [
        "SyncRoom"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
